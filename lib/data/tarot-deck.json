[
  {
    "id": "the_fool",
    "name_en": "The Fool",
    "name_zh": "愚者",
    "arcana_type": "major",
    "number": 0,
    "upright_keywords": ["新开始", "自发性", "信念", "纯真"],
    "upright_meaning": "愚者代表新的开始和无限的可能性。这是一张充满希望和潜力的牌,鼓励你迈出第一步,相信自己的直觉。",
    "reversed_keywords": ["鲁莽", "冒险", "愚昧", "缺乏计划"],
    "reversed_meaning": "逆位的愚者提醒你在行动前需要更多的思考和准备。避免不必要的风险和冲动的决定。"
  },
  {
    "id": "the_magician",
    "name_en": "The Magician",
    "name_zh": "魔术师",
    "arcana_type": "major",
    "number": 1,
    "upright_keywords": ["力量", "技能", "专注", "行动力"],
    "upright_meaning": "魔术师象征着你拥有实现目标所需的所有资源和能力。现在是将想法转化为现实的时候。",
    "reversed_keywords": ["操纵", "欺骗", "浪费天赋", "缺乏方向"],
    "reversed_meaning": "逆位的魔术师可能表示你正在浪费自己的才能,或者被他人操纵。重新审视你的目标和手段。"
  },
  {
    "id": "the_high_priestess",
    "name_en": "The High Priestess",
    "name_zh": "女祭司",
    "arcana_type": "major",
    "number": 2,
    "upright_keywords": ["直觉", "神秘", "潜意识", "智慧"],
    "upright_meaning": "女祭司鼓励你倾听内心的声音,相信你的直觉。有些事情不需要理性分析,而是需要感受。",
    "reversed_keywords": ["隐藏", "压抑", "忽视直觉", "肤浅"],
    "reversed_meaning": "逆位的女祭司暗示你可能忽视了内心的声音,或者被表面现象所迷惑。深入探索真相。"
  },
  {
    "id": "the_empress",
    "name_en": "The Empress",
    "name_zh": "皇后",
    "arcana_type": "major",
    "number": 3,
    "upright_keywords": ["丰盛", "养育", "创造力", "成长"],
    "upright_meaning": "皇后代表丰富和繁荣。这是一个充满创造力和成长的时期,你的努力将带来丰硕的成果。",
    "reversed_keywords": ["依赖", "窒息", "创意枯竭", "忽视自我"],
    "reversed_meaning": "逆位的皇后可能表示过度依赖他人,或者忽视了自己的需求。重新找回平衡和自我关怀。"
  },
  {
    "id": "the_emperor",
    "name_en": "The Emperor",
    "name_zh": "皇帝",
    "arcana_type": "major",
    "number": 4,
    "upright_keywords": ["权威", "结构", "稳定", "领导力"],
    "upright_meaning": "皇帝象征着秩序和稳定。通过建立清晰的结构和规则,你可以实现长期的成功。",
    "reversed_keywords": ["专制", "僵化", "控制欲", "缺乏纪律"],
    "reversed_meaning": "逆位的皇帝可能表示过度控制或缺乏灵活性。学会在权威和适应性之间找到平衡。"
  },
  {
    "id": "the_hierophant",
    "name_en": "The Hierophant",
    "name_zh": "教皇",
    "arcana_type": "major",
    "number": 5,
    "upright_keywords": ["传统", "教导", "信仰", "遵从"],
    "upright_meaning": "教皇代表传统智慧和正统价值观。向有经验的人寻求指导,尊重既定的规则和习俗。",
    "reversed_keywords": ["叛逆", "打破常规", "质疑权威", "个人信念"],
    "reversed_meaning": "逆位的教皇鼓励你挑战传统,找到自己的道路。不要盲目跟随,而是要独立思考。"
  },
  {
    "id": "the_lovers",
    "name_en": "The Lovers",
    "name_zh": "恋人",
    "arcana_type": "major",
    "number": 6,
    "upright_keywords": ["爱情", "和谐", "选择", "关系"],
    "upright_meaning": "恋人牌象征着深刻的连接和重要的选择。这是关于价值观一致和心灵契合的时刻。",
    "reversed_keywords": ["分歧", "失衡", "错误选择", "自我矛盾"],
    "reversed_meaning": "逆位的恋人可能表示关系中的不和谐或内心的冲突。重新审视你的价值观和优先事项。"
  },
  {
    "id": "the_chariot",
    "name_en": "The Chariot",
    "name_zh": "战车",
    "arcana_type": "major",
    "number": 7,
    "upright_keywords": ["胜利", "意志力", "决心", "前进"],
    "upright_meaning": "战车代表通过决心和意志力克服障碍。保持专注,你将朝着目标稳步前进。",
    "reversed_keywords": ["失控", "缺乏方向", "侵略性", "挫折"],
    "reversed_meaning": "逆位的战车暗示你可能失去了方向或控制。重新评估你的策略,找回平衡。"
  },
  {
    "id": "strength",
    "name_en": "Strength",
    "name_zh": "力量",
    "arcana_type": "major",
    "number": 8,
    "upright_keywords": ["勇气", "耐心", "内在力量", "温柔"],
    "upright_meaning": "力量牌展示的不是蛮力,而是内在的勇气和温柔的控制。用爱和耐心克服挑战。",
    "reversed_keywords": ["自我怀疑", "软弱", "滥用权力", "缺乏信心"],
    "reversed_meaning": "逆位的力量可能表示你正在经历自我怀疑或缺乏信心。重新连接你内在的力量源泉。"
  },
  {
    "id": "the_hermit",
    "name_en": "The Hermit",
    "name_zh": "隐士",
    "arcana_type": "major",
    "number": 9,
    "upright_keywords": ["内省", "独处", "智慧", "寻求真理"],
    "upright_meaning": "隐士鼓励你暂时退出喧嚣,进行内在的探索和反思。独处是获得智慧的途径。",
    "reversed_keywords": ["孤立", "逃避", "迷失", "拒绝帮助"],
    "reversed_meaning": "逆位的隐士可能表示过度孤立或逃避现实。重新连接外部世界,寻求平衡。"
  },
  {
    "id": "wheel_of_fortune",
    "name_en": "Wheel of Fortune",
    "name_zh": "命运之轮",
    "arcana_type": "major",
    "number": 10,
    "upright_keywords": ["变化", "循环", "机遇", "命运"],
    "upright_meaning": "命运之轮提醒我们生活是不断变化的。接受变化,抓住新的机遇,顺应生活的节奏。",
    "reversed_keywords": ["厄运", "抗拒变化", "运气不佳", "失控"],
    "reversed_meaning": "逆位的命运之轮可能表示你正在抗拒不可避免的变化。学会适应,相信一切都会过去。"
  },
  {
    "id": "justice",
    "name_en": "Justice",
    "name_zh": "正义",
    "arcana_type": "major",
    "number": 11,
    "upright_keywords": ["公平", "真理", "平衡", "因果"],
    "upright_meaning": "正义牌代表公平和真理。你的行为将带来相应的结果,保持诚实和正直。",
    "reversed_keywords": ["不公", "偏见", "逃避责任", "失衡"],
    "reversed_meaning": "逆位的正义可能表示不公平的待遇或逃避责任。面对真相,承担后果。"
  },
  {
    "id": "the_hanged_man",
    "name_en": "The Hanged Man",
    "name_zh": "吊人",
    "arcana_type": "major",
    "number": 12,
    "upright_keywords": ["暂停", "放手", "新视角", "牺牲"],
    "upright_meaning": "吊人鼓励你从不同的角度看待问题。有时候,放手和等待比行动更有智慧。",
    "reversed_keywords": ["拖延", "停滞", "抗拒", "无谓牺牲"],
    "reversed_meaning": "逆位的吊人可能表示你在无谓地拖延或做出不必要的牺牲。重新评估你的选择。"
  },
  {
    "id": "death",
    "name_en": "Death",
    "name_zh": "死神",
    "arcana_type": "major",
    "number": 13,
    "upright_keywords": ["结束", "转变", "重生", "释放"],
    "upright_meaning": "死神代表重要的转变和新生。结束旧的阶段,为新的开始腾出空间。",
    "reversed_keywords": ["抗拒变化", "停滞", "恐惧", "无法放手"],
    "reversed_meaning": "逆位的死神表示你正在抗拒必要的改变。接受结束,才能迎来新的开始。"
  },
  {
    "id": "temperance",
    "name_en": "Temperance",
    "name_zh": "节制",
    "arcana_type": "major",
    "number": 14,
    "upright_keywords": ["平衡", "和谐", "耐心", "调和"],
    "upright_meaning": "节制牌教导我们中庸之道。通过耐心和平衡,融合对立的力量,找到内在的和谐。",
    "reversed_keywords": ["失衡", "过度", "不耐烦", "冲突"],
    "reversed_meaning": "逆位的节制可能表示生活失去平衡或过度追求某一方面。重新找回中心点。"
  },
  {
    "id": "the_devil",
    "name_en": "The Devil",
    "name_zh": "恶魔",
    "arcana_type": "major",
    "number": 15,
    "upright_keywords": ["束缚", "诱惑", "物质主义", "上瘾"],
    "upright_meaning": "恶魔牌揭示我们对物质或欲望的依赖。认清束缚你的东西,才能获得真正的自由。",
    "reversed_keywords": ["解脱", "觉醒", "打破枷锁", "重获自由"],
    "reversed_meaning": "逆位的恶魔表示你正在打破旧的束缚,重获自由。继续努力,摆脱负面模式。"
  },
  {
    "id": "the_tower",
    "name_en": "The Tower",
    "name_zh": "塔",
    "arcana_type": "major",
    "number": 16,
    "upright_keywords": ["突变", "崩溃", "启示", "解放"],
    "upright_meaning": "塔代表突然的改变和结构的崩塌。虽然动荡,但这是清除旧有、重建更坚固基础的机会。",
    "reversed_keywords": ["逃避灾难", "延迟改变", "内在动荡", "恐惧"],
    "reversed_meaning": "逆位的塔可能表示你正在回避必要的改变。延迟只会让问题积累,勇敢面对。"
  },
  {
    "id": "the_star",
    "name_en": "The Star",
    "name_zh": "星星",
    "arcana_type": "major",
    "number": 17,
    "upright_keywords": ["希望", "灵感", "宁静", "更新"],
    "upright_meaning": "星星带来希望和灵感。即使在黑暗之后,也有光明和更新的可能。保持信念。",
    "reversed_keywords": ["失望", "缺乏信念", "悲观", "失去方向"],
    "reversed_meaning": "逆位的星星可能表示你感到失望或失去希望。重新连接你的梦想和内在的光芒。"
  },
  {
    "id": "the_moon",
    "name_en": "The Moon",
    "name_zh": "月亮",
    "arcana_type": "major",
    "number": 18,
    "upright_keywords": ["幻象", "直觉", "潜意识", "不确定"],
    "upright_meaning": "月亮代表潜意识和不确定性。相信你的直觉,但要警惕幻象和自我欺骗。",
    "reversed_keywords": ["混乱", "恐惧", "误解", "释放恐惧"],
    "reversed_meaning": "逆位的月亮可能表示你正在释放恐惧,或者被混乱和误解所困扰。寻求清晰。"
  },
  {
    "id": "the_sun",
    "name_en": "The Sun",
    "name_zh": "太阳",
    "arcana_type": "major",
    "number": 19,
    "upright_keywords": ["成功", "喜悦", "活力", "光明"],
    "upright_meaning": "太阳是塔罗牌中最积极的牌之一。它代表成功、喜悦和生命的活力。享受这美好的时刻。",
    "reversed_keywords": ["暂时失意", "过度乐观", "延迟快乐", "自我怀疑"],
    "reversed_meaning": "逆位的太阳可能表示暂时的阴霾或过度的乐观。保持现实的态度,光明即将到来。"
  },
  {
    "id": "judgement",
    "name_en": "Judgement",
    "name_zh": "审判",
    "arcana_type": "major",
    "number": 20,
    "upright_keywords": ["觉醒", "反思", "重生", "赎罪"],
    "upright_meaning": "审判牌代表重要的觉醒和内在的呼唤。反思过去,原谅自己,准备迎接新的阶段。",
    "reversed_keywords": ["自我怀疑", "逃避责任", "缺乏自我意识", "延迟判断"],
    "reversed_meaning": "逆位的审判可能表示你回避自我反思或难以原谅过去。面对真相,才能前进。"
  },
  {
    "id": "the_world",
    "name_en": "The World",
    "name_zh": "世界",
    "arcana_type": "major",
    "number": 21,
    "upright_keywords": ["完成", "成就", "整合", "圆满"],
    "upright_meaning": "世界牌代表一个周期的完成和成就。庆祝你的成功,同时准备开启新的旅程。",
    "reversed_keywords": ["未完成", "缺乏闭合", "延迟成功", "寻求完成"],
    "reversed_meaning": "逆位的世界可能表示某些事情尚未完成或需要更多努力。继续坚持,成功在望。"
  },
  {
    "id": "ace_of_wands",
    "name_en": "Ace of Wands",
    "name_zh": "权杖王牌",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["创造力", "灵感", "新开始", "潜力"],
    "upright_meaning": "权杖王牌代表创造力的爆发和新的开始。抓住这股能量,开启充满激情的项目。",
    "reversed_keywords": ["缺乏方向", "拖延", "创意枯竭", "挫折"],
    "reversed_meaning": "逆位的权杖王牌可能表示你感到缺乏灵感或难以开始。重新点燃你的热情。"
  },
  {
    "id": "two_of_wands",
    "name_en": "Two of Wands",
    "name_zh": "权杖二",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["计划", "远见", "决策", "探索"],
    "upright_meaning": "权杖二鼓励你制定长远计划,展望未来的可能性。现在是做出重要决策的时候。",
    "reversed_keywords": ["缺乏计划", "恐惧未知", "犹豫不决", "受限视野"],
    "reversed_meaning": "逆位的权杖二可能表示你对未来感到不确定或害怕做决定。勇敢迈出第一步。"
  },
  {
    "id": "three_of_wands",
    "name_en": "Three of Wands",
    "name_zh": "权杖三",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["扩展", "展望", "合作", "机遇"],
    "upright_meaning": "权杖三代表扩展和成长的机会。你的视野正在拓宽,新的可能性即将到来。",
    "reversed_keywords": ["障碍", "延迟", "缺乏远见", "过度谨慎"],
    "reversed_meaning": "逆位的权杖三可能表示计划遇到障碍或进展缓慢。保持耐心,重新评估策略。"
  },
  {
    "id": "four_of_wands",
    "name_en": "Four of Wands",
    "name_zh": "权杖四",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["庆祝", "和谐", "家庭", "里程碑"],
    "upright_meaning": "权杖四代表庆祝和稳定的时刻。享受你所建立的和谐,庆祝重要的里程碑。",
    "reversed_keywords": ["不稳定", "缺乏支持", "过渡期", "延迟庆祝"],
    "reversed_meaning": "逆位的权杖四可能表示家庭或关系中的不稳定。努力重建和谐和安全感。"
  },
  {
    "id": "five_of_wands",
    "name_en": "Five of Wands",
    "name_zh": "权杖五",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["竞争", "冲突", "多样性", "挑战"],
    "upright_meaning": "权杖五代表竞争和冲突。虽然有挑战,但这也是成长和学习的机会。",
    "reversed_keywords": ["避免冲突", "内在冲突", "协作", "解决分歧"],
    "reversed_meaning": "逆位的权杖五可能表示你正在回避必要的对抗,或者冲突即将得到解决。"
  },
  {
    "id": "six_of_wands",
    "name_en": "Six of Wands",
    "name_zh": "权杖六",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["胜利", "认可", "成功", "自信"],
    "upright_meaning": "权杖六代表公开的认可和成功。你的努力得到了回报,享受这一刻的荣耀。",
    "reversed_keywords": ["失败", "缺乏认可", "自我怀疑", "傲慢"],
    "reversed_meaning": "逆位的权杖六可能表示你感到不被认可或过于自负。保持谦逊,继续努力。"
  },
  {
    "id": "seven_of_wands",
    "name_en": "Seven of Wands",
    "name_zh": "权杖七",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["防御", "坚持", "勇气", "挑战"],
    "upright_meaning": "权杖七鼓励你坚守立场,勇敢面对挑战。即使面对压力,也要相信自己的信念。",
    "reversed_keywords": ["放弃", "压倒性", "缺乏信念", "屈服"],
    "reversed_meaning": "逆位的权杖七可能表示你感到不堪重负或准备放弃。重新评估你的优先事项。"
  },
  {
    "id": "eight_of_wands",
    "name_en": "Eight of Wands",
    "name_zh": "权杖八",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["快速行动", "进展", "运动", "消息"],
    "upright_meaning": "权杖八代表快速的进展和变化。事情正在加速,保持专注,准备好行动。",
    "reversed_keywords": ["延迟", "挫折", "仓促", "缺乏方向"],
    "reversed_meaning": "逆位的权杖八可能表示计划被延迟或你行动过于仓促。减速,重新调整方向。"
  },
  {
    "id": "nine_of_wands",
    "name_en": "Nine of Wands",
    "name_zh": "权杖九",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["韧性", "坚持", "防御", "毅力"],
    "upright_meaning": "权杖九代表在困难中的坚持。虽然疲惫,但成功就在眼前,继续保持。",
    "reversed_keywords": ["筋疲力尽", "偏执", "顽固", "放弃"],
    "reversed_meaning": "逆位的权杖九可能表示你已经筋疲力尽或过于防御。允许自己休息和接受帮助。"
  },
  {
    "id": "ten_of_wands",
    "name_en": "Ten of Wands",
    "name_zh": "权杖十",
    "arcana_type": "minor",
    "suit": "wands",
    "upright_keywords": ["负担", "责任", "压力", "完成"],
    "upright_meaning": "权杖十代表沉重的责任和负担。虽然辛苦,但你正接近目标的完成。",
    "reversed_keywords": ["释放负担", "委派", "解脱", "不堪重负"],
    "reversed_meaning": "逆位的权杖十可能表示你正在放下不必要的负担或需要学会委派。寻求平衡。"
  },
  {
    "id": "page_of_wands",
    "name_en": "Page of Wands",
    "name_zh": "权杖侍从",
